---
import "../styles/global.css";

export interface Props {
    title: string;
    description?: string;
    centered?: boolean;
}

const {
    title,
    description = "Secure, anonymous peer-to-peer file sharing directly in your browser. No cloud, no databases, 100% encrypted.",
    centered = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />

        <!-- SEO & OpenGraph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary_large_image" />

        <!-- Google Fonts for JetBrains Mono & Outfit -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&family=Outfit:wght@400;600;800;900&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="min-h-screen bg-[#070709] text-zinc-300 font-mono antialiased flex flex-col selection:bg-cyan-500 selection:text-black"
    >
        {
            centered ? (
                <main class="flex-1 flex flex-col items-center justify-center p-4 md:p-8">
                    <slot />
                </main>
            ) : (
                <slot />
            )
        }

        <footer class="py-8 border-t border-zinc-800 bg-[#070709] mt-auto">
            <div class="container mx-auto px-6 max-w-5xl space-y-4">
                <div
                    class="flex flex-col md:flex-row items-center justify-between gap-4 text-xs"
                >
                    <div
                        class="flex items-center gap-2 font-bold text-zinc-400"
                    >
                        <img
                            src="/logo.svg"
                            alt="Bitshare Logo"
                            class="w-4 h-4 shrink-0"
                        />
                        <span class="tracking-widest">BITSHARE</span>
                    </div>

                    <div class="flex items-center gap-6 font-mono text-xs">
                        <a
                            href="https://github.com/InledGroup/bitshare"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-zinc-500 hover:text-cyan-400 transition-colors flex items-center gap-1"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path
                                    d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                                ></path><path d="M9 18c-4.51 2-5-2-7-2"
                                ></path></svg
                            >
                            GitHub
                        </a>
                        <span class="text-zinc-600">hi@inled.es</span>
                    </div>
                </div>

                <p
                    class="text-[10px] text-zinc-600 leading-relaxed max-w-4xl text-center md:text-left font-mono"
                >
                    This page offers a simple way to share files via the P2P
                    network. As this is a zero-knowledge, non-cloud
                    infrastructure—and because we do not provide any
                    storage—Inled Group is not responsible for files sent
                    through the P2P network. This website merely provides a
                    file-transfer implementation that operates without our
                    infrastructure having any knowledge of the files themselves.
                    If you encounter any issues, please contact hi@inled.es.
                </p>
            </div>
        </footer>
    </body>
</html>

<style is:global>
    body {
        font-family: "JetBrains Mono", monospace;
    }
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        font-family: "Outfit", sans-serif;
    }
</style>
