---
import Layout from "../layouts/Layout.astro";
import Share from "../components/Share";
---

<Layout
    title="Share with Bitshare | Send files securely via P2P | The only auditable site, database-free and 100% static."
    centered={true}
>
    <div class="fixed top-6 left-6 z-50">
        <a
            href="/"
            class="flex items-center gap-2 p-3 bg-[#070709] border border-zinc-800 hover:border-cyan-500 text-zinc-400 hover:text-cyan-400 transition-colors rounded-none font-mono text-xs font-bold tracking-widest uppercase"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-arrow-left"
                ><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg
            >
            Home
        </a>
    </div>
    <Share client:only="react" />
</Layout>
